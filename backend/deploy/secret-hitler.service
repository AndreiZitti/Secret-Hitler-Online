[Unit]
Description=Secret Hitler Online Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/secret-hitler
ExecStart=/usr/bin/java -jar /opt/secret-hitler/secret-hitler.jar
Restart=always
RestartSec=10

# Environment variables
Environment=PORT=4040
# TODO: Enable database backup feature when PostgreSQL is set up
# Environment=DATABASE_URL=postgres://user:pass@localhost:5432/secrethitler

[Install]
WantedBy=multi-user.target
